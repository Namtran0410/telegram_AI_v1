{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "verbatimModuleSyntax": false,
    "noEmit": true,

    "baseUrl": ".",
    "ignoreDeprecations": "6.0",

    "paths": {
      "@fixture/*": ["tests/00.fixture/*"],
      "@business-flow/*": ["bussiness_flow/*"],
      "@infra/*": ["infra/*"]
    }
  },
  "include": [
    "infra/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "bussiness_flow/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
